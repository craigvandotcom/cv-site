{
  "autoMemoryEnabled": false,
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/Repos/.claude/hooks/memory-retrieval.py"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "cat $HOME/Repos/neometa/software/agent-compounds/hooks/delegation-reminder.md"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "for f in \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/delegation-reminder.md \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/workflow-reminder.md; do [ -f \"$f\" ] && cat \"$f\"; done; exit 0"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/Repos/neometa/software/agent-compounds/hooks/trauma_guard.py",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/Repos/neometa/software/agent-compounds/hooks/skill-edit-guard.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__qmd__get|mcp__qmd__multi_get|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/Repos/infrastructure/tools/src/lib/activity_logger.py"
          }
        ]
      }
    ]
  },
  "skillListingBudgetFraction": 0.02,
  "env": {
    "GIT_IDENTITY_ENABLED": "1",
    "AGENT_NAME": "FoggyCreek"
  }
}
