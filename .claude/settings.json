{
  "autoMemoryEnabled": false,
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/Repos/.claude/hooks/memory-retrieval.py"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/Repos/neometa/software/agent-compounds/hooks/trauma_guard.py",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/Repos/neometa/software/agent-compounds/hooks/skill-edit-guard.py",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "skillListingBudgetFraction": 0.02,
  "env": {
    "GIT_IDENTITY_ENABLED": "1",
    "AGENT_NAME": "FoggyCreek"
  }
}
